<div class="qin-cp">
  <header class="qin-cp-head">
    <img src="{{actor.img}}" alt="" data-action="openSheet" data-tooltip="Open the sheet">
    <div class="qin-cp-who"><b>{{actor.name}}</b>{{#if subtitle}}<div class="qin-cp-sub">{{subtitle}}</div>{{/if}}<span class="qin-cp-fight{{#if myTurn}} mine{{/if}}">{{fight}}{{#if myTurn}} · His turn{{/if}}</span></div>
    <div class="qin-cp-meters">
      {{#if chi}}<div class="qin-cp-meter"><span>Chi</span><b>{{chi.value}}</b><small>/ {{chi.max}}</small><div class="qin-cp-bar chi"><i style="width: {{chi.pct}}%"></i></div></div>{{/if}}
      {{#if bol}}<div class="qin-cp-meter"><span>{{#if bol.henchman}}Health{{else}}Breath of Life{{/if}}</span><b>{{bol.value}}</b><small>/ {{bol.max}}</small><div class="qin-cp-bar bol"><i style="width: {{bol.pct}}%"></i></div></div>{{/if}}
      {{#if actions}}<div class="qin-cp-meter narrow"><span>Actions</span><b>{{actions.left}}</b><small>/ {{actions.max}}</small><div class="qin-cp-pips">{{#each actions.pips}}<i class="qin-pip {{#if this}}full{{/if}}"></i>{{/each}}</div></div>{{/if}}
    </div>
  </header>
  <div class="qin-cp-body">
    <div class="qin-cp-col">
      <section class="qin-cp-card">
        <h4>At a glance <small>hover for details</small></h4>
        <div class="qin-cp-stats">{{#each glance}}<div class="qin-cp-stat" data-tooltip="{{tip}}" data-tooltip-class="qin-sig-tooltip"><span>{{label}}</span><b>{{value}}</b></div>{{/each}}</div>
      </section>

      <section class="qin-cp-card">
        <h4>{{#if myTurn}}Your turn{{else}}Fight{{/if}}</h4>
        {{#if incoming}}
        <div class="qin-cp-incoming"><b>Incoming attack:</b> {{incoming.attacker}} rolled {{incoming.total}}{{#if incoming.st}} against {{incoming.st}}{{/if}} · damage {{incoming.damage}}
          <div class="qin-cp-btnrow">
            <button type="button" class="qin-cp-gold" data-action="defend" data-type="block" data-msg="{{incoming.msg}}">Block</button>
            <button type="button" class="qin-cp-gold" data-action="defend" data-type="dodge" data-msg="{{incoming.msg}}">Dodge</button>
            {{#if incoming.isGM}}<button type="button" data-action="takeHit" data-msg="{{incoming.msg}}">Take the hit</button>{{/if}}
            <button type="button" class="qin-cp-x" data-action="dismissIncoming" data-msg="{{incoming.msg}}" data-tooltip="Hide (defended or taken from the chat card)">&times;</button>
          </div>
        </div>
        {{/if}}
        <div class="qin-cp-target">{{#if target}}Target: <b>{{target.name}}</b>{{#if target.pd}} · Passive Defense {{target.pd}}{{/if}}{{#if target.yd}} · {{target.yd}} {{target.units}} away{{/if}}{{else}}<span class="qin-cp-dim">No target: Attack picks one on the map.</span>{{/if}}</div>
        {{#each weapons}}
        <div class="qin-cp-weapon"><img src="{{img}}" alt=""><div class="qin-cp-grow"><b>{{name}}</b><div class="qin-cp-dim">{{sub}}</div></div><button type="button" class="qin-cp-red" data-action="attack" data-id="{{id}}">Attack</button></div>
        {{else}}<p class="qin-cp-dim">No weapon equipped.</p>{{/each}}
        {{#if myTurn}}<div class="qin-cp-btnrow end"><button type="button" data-action="endTurn">End turn ▸</button></div>{{/if}}
      </section>

      {{#if techniques.length}}
      <section class="qin-cp-card">
        <h4>Techniques <small>chosen in the Attack or Block window</small></h4>
        <div class="qin-cp-chips">{{#each techniques}}<span class="qin-cp-chip" data-tooltip="{{tip}}" data-tooltip-class="qin-sig-tooltip">{{name}}</span>{{/each}}</div>
      </section>
      {{/if}}

      {{#if situational.length}}
      <section class="qin-cp-card">
        <h4>Situational <small>ticked ones apply to the next roll</small></h4>
        {{#each situational}}
        <label class="qin-cp-row"><input type="checkbox" data-sit-key="{{key}}" {{#if checked}}checked{{/if}}><span class="qin-cp-grow">{{text}}{{#if condition}} <span class="qin-cp-dim">({{condition}})</span>{{/if}}</span></label>
        {{/each}}
      </section>
      {{/if}}
    </div>

    <div class="qin-cp-col">
      <section class="qin-cp-card">
        <h4>In effect now</h4>
        {{#each inEffect}}
        <div class="qin-cp-row{{#if reminder}} qin-cp-reminder{{/if}}"><span class="qin-cp-tag {{kind}}">{{#if (eq kind "tao")}}Tao{{else}}Unique{{/if}}</span><span class="qin-cp-grow">{{text}}</span><span class="qin-cp-dim">{{left}}</span>{{#if canEnd}}<button type="button" class="qin-cp-small" data-action="endEffect" data-id="{{id}}">End</button>{{/if}}</div>
        {{/each}}
        {{#each alwaysRows}}
        <div class="qin-cp-row"><span class="qin-cp-tag unique">{{#if aura}}Aura{{else}}Unique{{/if}}</span><span class="qin-cp-grow">{{text}}</span></div>
        {{/each}}
        {{#unless inEffect.length}}{{#unless alwaysRows.length}}<p class="qin-cp-dim">Nothing in effect.</p>{{/unless}}{{/unless}}
        {{#each growing}}
        <div class="qin-cp-row"><span class="qin-cp-tag unique">Grows</span><span class="qin-cp-grow">{{text}}<div class="qin-cp-dim">{{sub}}</div></span>
          <button type="button" class="qin-cp-step" data-action="stackDown" data-key="{{key}}" {{#unless canDown}}disabled{{/unless}} aria-label="One step less">&minus;</button>
          <button type="button" class="qin-cp-step" data-action="stackUp" data-key="{{key}}" {{#unless canUp}}disabled{{/unless}} aria-label="One step more">+</button></div>
        {{/each}}
        <div class="qin-cp-ready">Ready for the next roll:
          {{#each queued}}{{#each items}}<div class="qin-cp-row"><span class="qin-cp-dim">{{../label}}</span><span class="qin-cp-grow">{{text}}</span><button type="button" class="qin-cp-x" data-action="unqueue" data-id="{{id}}" data-tooltip="Remove (nothing was spent)">&times;</button></div>{{/each}}
          {{else}}<span class="qin-cp-dim">nothing waiting</span>{{/each}}
        </div>
      </section>

      {{#if taos.length}}
      <section class="qin-cp-card">
        <h4>Taos <small>hover for details · click to use</small></h4>
        {{#each taos}}
        <div class="qin-cp-tao"><div class="qin-cp-tao-name">{{name}}</div>
          <div class="qin-cp-chips">{{#each buttons}}<button type="button" data-action="tao" data-tao-id="{{../id}}" data-level="{{level}}" class="qin-cp-taobtn{{#if disabled}} off{{/if}}{{#if manual}} manual{{/if}}" data-tooltip="{{tip}}" data-tooltip-class="qin-sig-tooltip" data-tooltip-direction="LEFT">{{label}}</button>{{/each}}</div>
        </div>
        {{/each}}
      </section>
      {{/if}}

      {{#if actives.length}}
      <section class="qin-cp-card">
        <h4>Unique actives</h4>
        {{#each actives}}
        <div class="qin-cp-active"><div class="qin-cp-grow"><b>{{name}}</b><div class="qin-cp-dim">{{sub}}{{#if recharge}} · {{recharge}}{{/if}}</div></div>
          {{#if ready}}{{#if cost}}<span class="qin-cp-cost">{{cost}} Chi</span>{{/if}}<button type="button" class="qin-cp-gold" data-action="useActive" data-id="{{id}}">Use</button>{{else}}<span class="qin-cp-dim">{{status}}</span>{{/if}}</div>
        {{/each}}
      </section>
      {{/if}}
    </div>
  </div>
</div>
