<div class="qin-battle-scroll qin-gm">
  <div class="qin-card qin-gm-ai"><h4>Battle AI</h4>
    <p class="qin-muted">Plays a side's units on its turns. It plays as well as that side's tactician (Art of War); without one, as Art of War 1.</p>
    <div class="qin-btns">
      <button type="button" data-action="aiSide" data-side="enemy" class="{{#if ai.enemy}}active{{/if}}" title="Let the AI play the enemy side"><i class="fa-solid fa-{{#if ai.enemy}}toggle-on{{else}}toggle-off{{/if}}"></i> Enemy <small>AoW {{ai.enemyLv}}</small></button>
      <button type="button" data-action="aiSide" data-side="ally" class="{{#if ai.ally}}active{{/if}}" title="Let the AI play the allied side"><i class="fa-solid fa-{{#if ai.ally}}toggle-on{{else}}toggle-off{{/if}}"></i> Ally <small>AoW {{ai.allyLv}}</small></button>
    </div>
    {{#if ai.any}}<div class="qin-btns"><button type="button" data-action="aiPause" title="Stop or restart the AI">{{#if ai.paused}}<i class="fa-solid fa-play"></i> Resume AI{{else}}<i class="fa-solid fa-pause"></i> Pause AI{{/if}}</button></div>{{/if}}
  </div>
  <div class="qin-card qin-gm-camera"><h4>Camera</h4>
    <div class="qin-btns">
      <button type="button" data-action="pullCamera" class="{{#if cameraPick}}active{{/if}}" title="Then click a tile: every player's view pans there (Shift+C)"><i class="fa-solid fa-{{#if cameraPick}}crosshairs{{else}}video{{/if}}"></i> {{#if cameraPick}}Click a tile… (Esc cancels){{else}}Move everyone's camera to a tile{{/if}}</button>
    </div>
  </div>
  <div class="qin-card"><h4>Selected units</h4>
    {{#if selected.length}}
      <ul class="qin-gm-sel">{{#each selected}}<li><img src="{{img}}" alt=""><span class="qin-gm-side-dot qin-side-{{side}}" title="{{side}}"></span><b>{{name}}</b><span class="qin-gm-lv">{{{chev}}} Lv {{level}}</span></li>{{/each}}</ul>
    {{else}}<p class="qin-muted">Select unit tokens on the map.</p>{{/if}}
    <div class="qin-btns">
      <button type="button" data-action="setHidden" data-hidden="1" title="Hide the unit tokens you have selected"><i class="fa-solid fa-eye-slash"></i> Hide</button>
      <button type="button" data-action="setHidden" data-hidden="0" title="Reveal the unit tokens you have selected"><i class="fa-solid fa-eye"></i> Reveal</button>
    </div>
    <div class="qin-btns">
      <button type="button" data-action="level" data-step="1" title="Raise the selected units one level (up to 5)" {{#unless canUp}}disabled{{/unless}}><i class="fa-solid fa-angles-up"></i> Level up</button>
      <button type="button" data-action="level" data-step="-1" title="Lower the selected units one level (down to 1)" {{#unless canDown}}disabled{{/unless}}><i class="fa-solid fa-angles-down"></i> Level down</button>
    </div>
    <div class="qin-btns">
      <button type="button" data-action="restore" data-kind="heal" title="Heal the selected units to full health" {{#unless selected.length}}disabled{{/unless}}><i class="fa-solid fa-heart-pulse"></i> Heal</button>
      <button type="button" data-action="restore" data-kind="morale" title="Set the selected units' morale to their base (resting) morale: 50, or more with Disciplined" {{#unless selected.length}}disabled{{/unless}}><i class="fa-solid fa-flag"></i> Morale to base</button>
    </div>
    <div class="qin-gm-sidebar"><span class="qin-gm-sidelabel">Side</span>
      <div class="qin-btns qin-gm-sides">{{#each sides}}<button type="button" data-action="setSide" data-side="{{key}}" class="qin-side-{{key}} {{#if on}}active{{/if}}" title="Put the selected units on the {{key}} side" {{#unless ../selected.length}}disabled{{/unless}}>{{label}}</button>{{/each}}</div>
    </div>
  </div>
</div>
