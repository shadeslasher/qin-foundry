<div class="qin-battle-wrap">
{{#unless active}}
  <div class="qin-card">
    <h3>No battle running</h3>
    {{#if isGM}}
      <p>Place Unit tokens on the scene (<b>{{sceneName}}</b>), give officer units their officer, then start.</p>
      <button type="button" data-action="startBattle" class="qin-primary">Start battle on this scene</button>
      <p class="qin-muted">Name scene Regions "Trees", "Tall grass" or "Impassable" to give terrain to stealth and encirclement.</p>
    {{else}}
      <p>The GM hasn't started a battle.</p>
    {{/if}}
  </div>
{{else}}
  {{#if wrongScene}}<p class="qin-warn">The battle is on scene <b>{{battleScene}}</b>.</p>{{/if}}
  <div class="qin-card qin-prompt">
    <h3>{{#if round}}Round {{round}} · {{/if}}{{phase}}</h3>
    <p>{{{prompt.text}}}</p>
    <div class="qin-btns">
      {{#each prompt.buttons}}
      <button type="button" data-action="do" data-type="{{action}}" {{#if unitId}}data-unit-id="{{unitId}}"{{/if}} {{#if choice}}data-choice="{{choice}}"{{/if}} class="{{#if primary}}qin-primary{{/if}}" {{#if disabled}}disabled{{/if}}>{{label}}</button>
      {{/each}}
    </div>
  </div>

  {{#if held.length}}
  <div class="qin-card qin-held">
    <h4>Holding — may interject</h4>
    <div class="qin-portraits">
      {{#each held}}
      <div class="qin-portrait-card {{#if can}}can{{/if}}">
        <img src="{{img}}"><div class="qin-pname">{{name}}</div><div class="qin-muted">Init {{init}}</div>
        {{#if mine}}<button type="button" data-action="do" data-type="interject" data-unit-id="{{id}}" {{#unless can}}disabled{{/unless}}>Interject</button>{{/if}}
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{#if controls}}
  <div class="qin-card qin-controls-card">
    <h4>{{controls.name}} — your turn</h4>
    <p>Use the action menu beside the unit on the map: <b>Move</b>, <b>Attack</b>, <b>Hold</b>, <b>Ability</b>, <b>Heroic action</b> or <b>End turn</b>.</p>
    {{#if controls.heroicLeft}}<p class="qin-muted">Heroic actions left: {{controls.heroicLeft}}</p>{{/if}}
    <div class="qin-btns"><button type="button" data-action="do" data-type="endTurn" data-unit-id="{{controls.id}}">End turn</button></div>
  </div>
  {{/if}}

  <div class="qin-battle-scroll">
    {{#if order.length}}
    <div class="qin-card"><h4>Initiative</h4>
      <ul class="qin-order">{{#each order}}<li class="{{#if now}}now{{/if}}"><span>{{init}} · {{name}}</span><span class="qin-muted">{{state}}</span></li>{{/each}}</ul>
    </div>
    {{/if}}

    <div class="qin-card"><h4>Units</h4>
      <ul class="qin-units">
        {{#each units}}
        <li class="qin-side-{{side}} {{#if done}}done{{/if}} {{#unless (eq status "active")}}out{{/unless}}">
          <img src="{{img}}" data-action="selectUnit" data-unit-id="{{id}}" title="Select token">
          <div class="qin-uinfo">
            <div><b>{{name}}</b>{{#if officer}} <span class="qin-muted">({{officer}})</span>{{/if}}</div>
            <div class="qin-muted">{{men}}/{{maxMen}} health · {{morale}} morale · {{xp}} XP ({{moraleState}}){{#unless (eq status "active")}} · {{status}}{{/unless}}</div>
            {{#if formationOptions}}
              <select data-formation-unit="{{id}}">{{#each formationOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
            {{else}}<div class="qin-muted">{{formation}}</div>{{/if}}
          </div>
          {{#if pickable}}<button type="button" class="qin-primary" data-action="do" data-type="begin" data-unit-id="{{id}}">Take turn</button>{{/if}}
        </li>
        {{/each}}
      </ul>
    </div>

    <div class="qin-card"><h4>Recent</h4>
      <ul class="qin-log">{{#each log}}<li>{{this}}</li>{{/each}}</ul>
    </div>

    {{#if isGM}}
    <div class="qin-card"><h4>GM</h4>
      <div class="qin-btns">
        {{#if showSkip}}<button type="button" data-action="do" data-type="skipPrompt">Skip current turn</button>{{/if}}
        <button type="button" data-action="do" data-type="resetBattle">Back to setup</button>
        <button type="button" data-action="endBattle">End battle</button>
      </div>
    </div>
    {{/if}}
  </div>
{{/unless}}
</div>
