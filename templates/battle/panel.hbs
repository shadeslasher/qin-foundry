{{#*inline "objectivesCard"}}
  <div class="qin-card qin-obj-card"><h4>Victory &amp; defeat</h4>
    <div class="qin-obj-grp v"><i class="fa-solid fa-flag"></i> Victory <span class="qin-muted">complete all</span></div>
    <ul class="qin-obj-rows">
      {{#each objCard.victory}}{{> objRow}}{{else}}<li class="qin-muted qin-obj-none">No victory conditions: the battle won't end in victory by itself.</li>{{/each}}
    </ul>
    <select class="qin-obj-add" data-obj-add="victory"><option value="">+ Add victory condition…</option>{{#each objCard.victoryTypes}}<option value="{{k}}">{{label}}</option>{{/each}}</select>
    <div class="qin-obj-grp d"><i class="fa-solid fa-skull"></i> Defeat <span class="qin-muted">any one</span></div>
    <ul class="qin-obj-rows">
      {{#each objCard.defeat}}{{> objRow}}{{/each}}
      <li class="qin-obj-row always"><span class="qin-obj-sw" style="border-color:#8a8578"></span><span class="qin-obj-what">All player units routed (always)</span><span></span></li>
    </ul>
    <select class="qin-obj-add" data-obj-add="defeat"><option value="">+ Add defeat condition…</option>{{#each objCard.defeatTypes}}<option value="{{k}}">{{label}}</option>{{/each}}</select>
    <p class="qin-muted">Saved with this scene. Players see the conditions in the top right once the battle starts.</p>
  </div>
{{/inline}}
{{#*inline "objRow"}}
  <li class="qin-obj-row{{#if paired}} paired{{/if}}"><span class="qin-obj-sw" style="border-color:{{color}}{{#if escape}};background:rgba(255,79,168,.45){{/if}}"></span>
    <span class="qin-obj-what"><b>{{label}}</b>
      {{#if needsUnits}}<span class="qin-obj-chip">{{units}}</span><button type="button" data-action="objPick" data-id="{{id}}" data-kind="units" class="{{#if pickingUnits}}qin-on{{/if}}">{{#if pickingUnits}}<i class="fa-solid fa-check"></i> Done{{else}}<i class="fa-solid fa-crosshairs"></i> Pick units{{/if}}</button>{{/if}}
      {{#if needsTile}}<span class="qin-obj-chip">{{tile}}</span>{{#unless paired}}<button type="button" data-action="objPick" data-id="{{id}}" data-kind="tile" class="{{#if pickingTile}}qin-on{{/if}}"><i class="fa-solid fa-crosshairs"></i> Pick tile</button>{{/unless}}{{/if}}
      {{#if rounds}}{{#if (eq type "hold")}}for {{/if}}<input type="number" min="1" value="{{rounds}}" data-obj-rounds="{{id}}"> rounds{{/if}}
      {{#if escape}}<span class="qin-obj-chip">{{@root.objCard.extraction}} extraction square{{#unless (eq @root.objCard.extraction 1)}}s{{/unless}}</span>
        <button type="button" data-action="objExtract" data-mode="paint" class="{{#if (eq @root.objCard.brush "paint")}}qin-on{{/if}}"><i class="fa-solid fa-paintbrush"></i> Paint</button>
        <button type="button" data-action="objExtract" data-mode="erase" class="{{#if (eq @root.objCard.brush "erase")}}qin-on{{/if}}"><i class="fa-solid fa-eraser"></i> Erase</button>{{/if}}
      {{#if paired}}<span class="qin-muted">(goes with the Hold)</span>{{/if}}
    </span>
    {{#if paired}}<span></span>{{else}}<a data-action="objRemove" data-id="{{id}}" title="Remove"><i class="fa-solid fa-xmark"></i></a>{{/if}}
  </li>
{{/inline}}
{{#*inline "deployCard"}}
  <div class="qin-card qin-deploy-card"><h4>Deployment zones</h4>
    <div class="qin-deploy-btns">
      <button type="button" data-action="zonePaint" class="{{#if (eq deploy.mode "paint")}}qin-on{{/if}}" title="Click or drag over the map to add deployment squares"><i class="fa-solid fa-paintbrush"></i> Paint zone</button>
      <button type="button" data-action="zoneErase" class="{{#if (eq deploy.mode "erase")}}qin-on{{/if}}" title="Click or drag over squares to remove them"><i class="fa-solid fa-eraser"></i> Erase zone</button>
      <button type="button" data-action="zoneClear" class="qin-wide" {{#unless deploy.count}}disabled{{/unless}}><i class="fa-solid fa-xmark"></i> Remove all zones</button>
      <button type="button" data-action="zoneConfirm" class="qin-wide qin-primary" {{#unless deploy.changed}}disabled{{/unless}}><i class="fa-solid fa-check"></i> Confirm zones</button>
    </div>
    <p class="qin-muted"><span class="qin-deploy-chip"></span>
      {{#if deploy.changed}}{{deploy.count}} square{{#unless (eq deploy.count 1)}}s{{/unless}} painted, not saved yet. <a data-action="zoneDiscard">Discard changes</a>
      {{else}}{{#if deploy.count}}{{deploy.count}} square{{#unless (eq deploy.count 1)}}s{{/unless}} saved on this scene. Players drag their units onto them during the tactics phase.
      {{else}}No deployment zones on this scene: players won't be able to move their units.{{/if}}{{/if}}
      {{#if deploy.mode}}<br>Right-click or Esc stops the brush.{{/if}}</p>
  </div>
{{/inline}}
<div class="qin-battle-wrap">
{{#unless active}}
  <div class="qin-battle-scroll">
  <div class="qin-card">
    <h3>No battle running</h3>
    {{#if isGM}}
      <p>Place Unit tokens on the scene (<b>{{sceneName}}</b>), give officer units their officer, then start.</p>
      <button type="button" data-action="startBattle" class="qin-primary">Start battle on this scene</button>
      <button type="button" data-action="importMap" title="Create a scene from a map generator file (.battlemap.json)"><i class="fa-solid fa-map"></i> Import battle map…</button>
      <p class="qin-muted">Scenes imported from the map generator know every square's terrain. On other scenes, name Regions "Trees", "Tall grass" or "Impassable" for terrain.</p>
      {{#if sceneUnits.length}}
      <h4>Sides</h4>
      <p class="qin-muted">Different sides fight each other; units on the same side never do.</p>
      <ul class="qin-units">
        {{#each sceneUnits}}
        <li class="qin-side-{{side}}"><img src="{{img}}" data-action="selectUnit" data-unit-id="{{id}}" title="Go to this unit">
          <div class="qin-uinfo"><b>{{name}}</b></div>
          {{#if @root.isGM}}<select data-side-unit="{{id}}">{{#each ../sideChoices}}<option value="{{@key}}" {{#if (eq @key ../side)}}selected{{/if}}>{{this}}</option>{{/each}}</select>{{/if}}
        </li>
        {{else}}<li class="qin-muted">{{#if isGM}}No unit tokens on this scene yet.{{else}}You don't control any units on this scene.{{/if}}</li>
        {{/each}}
      </ul>
      {{/if}}
      {{#if isGM}}<div class="qin-btns"><button type="button" data-action="gmPanel" title="Hide/reveal and level up or down the selected units"><i class="fa-solid fa-sliders"></i> GM controls</button></div>{{/if}}
    {{else}}
      <p>The GM hasn't started a battle.</p>
    {{/if}}
  </div>
  {{#if deploy}}{{> deployCard}}{{/if}}
  {{#if objCard}}{{> objectivesCard}}{{/if}}
  </div>
{{else}}
  {{#if wrongScene}}<p class="qin-warn">The battle is on scene <b>{{battleScene}}</b>.</p>{{/if}}
  <div class="qin-card qin-prompt">
    <h3>{{#if roundLabel}}{{roundLabel}} · {{else if round}}Round {{round}} · {{/if}}{{phase}}</h3>
    <p>{{{prompt.text}}}</p>
    <div class="qin-btns">
      {{#each prompt.buttons}}
      <button type="button" data-action="do" data-type="{{action}}" {{#if unitId}}data-unit-id="{{unitId}}"{{/if}} {{#if choice}}data-choice="{{choice}}"{{/if}} class="{{#if primary}}qin-primary{{/if}}" {{#if disabled}}disabled{{/if}}>{{label}}</button>
      {{/each}}
    </div>
  </div>
  {{#if siegeCard}}
  <div class="qin-card qin-siege-switch">
    <div class="qin-siege-row"><i class="fa-solid fa-dungeon"></i><b>Allow siege equipment</b>
      <button type="button" class="qin-switch {{#if siegeCard.on}}on{{/if}}" data-action="do" data-type="allowSiege" data-on="{{#if siegeCard.on}}false{{else}}true{{/if}}" title="{{#if siegeCard.on}}Lock siege equipment{{else}}Let players hand out ladders and engines, and place catapults{{/if}}"><span></span></button></div>
    <p class="qin-muted">{{#if siegeCard.on}}Players can hand out ladders and engines and place catapults (Party panel, Siege tab).{{else}}Off when deployment starts. On: players hand out siege equipment and place catapults.{{/if}}</p>
  </div>
  {{/if}}
  <div class="qin-battle-scroll">{{!-- everything under the prompt scrolls, the deploy list included (2026-11-01) --}}
  {{#if deploy}}{{> deployCard}}{{/if}}
  {{#if objCard}}{{> objectivesCard}}{{/if}}

  {{#if deployList}}
  <div class="qin-card qin-deploy-list"><h4>Deploy units</h4>
    <ul class="qin-units">
      {{#each deployList.units}}
      <li class="qin-side-player {{#if placed}}placed{{/if}}">
        <img src="{{img}}">
        <div class="qin-uinfo">
          <div><b>{{name}}</b>{{#if officer}} <span class="qin-muted">({{officer}})</span>{{/if}}</div>
          <div class="qin-muted">{{#if ../deployList.showOwner}}{{owner}} · {{/if}}{{#if placed}}On the field{{else}}{{#if why}}{{why}}{{else}}In reserve{{/if}}{{/if}}</div>
        </div>
        {{#if placed}}<button type="button" data-action="undeployUnit" data-actor-id="{{id}}" title="Take the unit off the map"><i class="fa-solid fa-rotate-left"></i> Undeploy</button>
        {{else}}<button type="button" class="qin-primary" data-action="deployUnit" data-actor-id="{{id}}" {{#unless canDeploy}}disabled{{/unless}} title="Place the unit on the top-left free deployment square"><i class="fa-solid fa-chess-pawn"></i> Deploy</button>{{/if}}
      </li>
      {{else}}<li class="qin-muted">You have no units to deploy.</li>
      {{/each}}
    </ul>
  </div>
  {{/if}}

  {{#if held.length}}
  <div class="qin-card qin-held">
    <h4>Holding — may interject</h4>
    <div class="qin-portraits">
      {{#each held}}
      <div class="qin-portrait-card {{#if can}}can{{/if}}">
        <img src="{{img}}"><div class="qin-pname">{{name}}</div><div class="qin-muted">Init {{init}}</div>
        {{#if mine}}<button type="button" data-action="do" data-type="interject" data-unit-id="{{id}}" {{#unless can}}disabled{{/unless}}>Interject</button>{{/if}}
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{#if controls}}
  <div class="qin-card qin-controls-card">
    <h4>{{controls.name}} — your turn</h4>
    <p>Use the action menu beside the unit on the map: <b>Move</b>, <b>Attack</b>, <b>Hold</b>, <b>Ability</b> or <b>End turn</b>.</p>
    <div class="qin-btns"><button type="button" data-action="do" data-type="endTurn" data-unit-id="{{controls.id}}">End turn</button></div>
  </div>
  {{/if}}

    {{#if order.length}}
    <div class="qin-card"><h4>Initiative</h4>
      <ul class="qin-order">{{#each order}}<li class="{{#if now}}now{{/if}} qin-goto" data-action="selectUnit" data-unit-id="{{id}}" title="Go to this unit"><span>{{init}} · {{name}}{{#if unit}} <span class="qin-muted">({{unit}})</span>{{/if}}</span><span class="qin-muted">{{state}}</span></li>{{/each}}</ul>
    </div>
    {{/if}}

    <div class="qin-card"><h4 class="qin-units-head">Units
        <button type="button" class="qin-mini" data-action="toggleCompact" title="{{#if compactUnits}}Show health, morale and side{{else}}Show only names{{/if}}"><i class="fa-solid {{#if compactUnits}}fa-up-right-and-down-left-from-center{{else}}fa-down-left-and-up-right-to-center{{/if}}"></i> {{#if compactUnits}}More info{{else}}Less info{{/if}}</button></h4>
      <ul class="qin-units {{#if compactUnits}}compact{{/if}}">
        {{#each units}}
        <li class="qin-side-{{side}} {{#if done}}done{{/if}} {{#unless (eq status "active")}}out{{/unless}}">
          <img src="{{img}}" data-action="selectUnit" data-unit-id="{{id}}" title="Go to this unit">
          <div class="qin-uinfo">
            <div class="qin-goto" data-action="selectUnit" data-unit-id="{{id}}" title="Go to this unit"><b>{{name}}</b>{{#if officer}} <span class="qin-muted">({{officer}})</span>{{/if}}</div>
            <div class="qin-muted qin-udetail">{{men}}/{{maxMen}} health · {{morale}} morale{{#if (eq side "player")}} · {{xp}} XP{{/if}} ({{moraleState}}){{#unless (eq status "active")}} · {{status}}{{/unless}}</div>
            <div class="qin-udetail">
            {{#if sideEditable}}<select data-side-unit="{{id}}" title="Side (can change before initiative)">{{#each ../sideChoices}}<option value="{{@key}}" {{#if (eq @key ../side)}}selected{{/if}}>{{this}}</option>{{/each}}</select>{{/if}}
            </div>
          </div>
          {{#if pickable}}<button type="button" class="qin-primary" data-action="do" data-type="begin" data-unit-id="{{id}}">Take turn</button>{{/if}}
        </li>
        {{else}}<li class="qin-muted">You don't control any units in this battle.</li>
        {{/each}}
      </ul>
    </div>

    <details class="qin-card qin-recent" {{#unless recentClosed}}open{{/unless}}><summary><h4>Recent</h4></summary>
      <ul class="qin-log">{{#each log}}<li>{{this}}</li>{{/each}}</ul>
    </details>

    {{#if isGM}}
  <div class="qin-card qin-gm-battle"><h4>Battle controls</h4>
    <div class="qin-btns">
      <button type="button" data-action="gmFire" class="{{#if gmFireOn}}qin-on{{/if}}" title="Click squares on the map to set them alight (only ones that can burn). Right-click or Esc stops."><i class="fa-solid fa-fire"></i> {{#if gmFireOn}}Stop setting fires{{else}}Set fire{{/if}}</button>
      {{#if tacticsWaiting}}<button type="button" data-action="do" data-type="triggerAllTactics" title="Set off every placed tactic that hasn't fired yet ({{tacticsWaiting}}). Raise Flag and Set Aflame stay until a unit takes their action."><i class="fa-solid fa-chess-knight"></i> Trigger all tactics ({{tacticsWaiting}})</button>{{/if}}
      {{#if showSkip}}<button type="button" data-action="do" data-type="skipPrompt">Skip current turn</button>{{/if}}
    </div>
    <div class="qin-btns">
      <button type="button" data-action="do" data-type="resetBattle">Back to setup</button>
      <button type="button" data-action="endBattle">End battle</button>
    </div>
    {{#if canDeclare}}<div class="qin-btns">
      <button type="button" class="qin-declare win" data-action="do" data-type="declareOutcome" data-result="victory" title="End the battle now as a victory (everyone sees the Victory banner)"><i class="fa-solid fa-flag"></i> Victory</button>
      <button type="button" class="qin-declare lose" data-action="do" data-type="declareOutcome" data-result="defeat" title="End the battle now as a defeat (everyone sees the Defeat banner)"><i class="fa-solid fa-skull"></i> Defeat</button>
      <button type="button" class="qin-declare draw" data-action="do" data-type="declareOutcome" data-result="stalemate" title="End the battle now as a stalemate (everyone sees the Stalemate banner)"><i class="fa-solid fa-handshake"></i> Stalemate</button>
    </div>{{/if}}
  </div>
    {{#if gates.length}}
    <div class="qin-card"><h4>City gates</h4>
      <p class="qin-muted">Owner: that side can open and shut it from outside; the other side can attack it. Setting a broken gate back to Locked or Open repairs it.</p>
      {{#each gates}}
      <div class="qin-gate-row"><span>Gate {{where}} <span class="qin-muted">{{hp}}/{{maxHp}}</span></span>
        <select data-gate="{{id}}" data-field="owner">{{#each owners}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{l}}</option>{{/each}}</select>
        <select data-gate="{{id}}" data-field="state">{{#each states}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{l}}</option>{{/each}}</select>
      </div>
      {{/each}}
    </div>
    {{/if}}
    {{#if reinforce}}<div class="qin-card qin-rz"><h4>Reinforcements</h4>
      {{#each reinforce.zones}}
      <div class="qin-rz-row {{#if arrived}}arrived{{/if}}">
        <span class="qin-rz-dot"></span>
        <div class="qin-rz-main"><b>{{name}}</b> <span class="qin-muted">{{squares}} square{{#unless (eq squares 1)}}s{{/unless}} · {{waiting}} unit{{#unless (eq waiting 1)}}s{{/unless}} waiting</span>
          <div class="qin-muted">{{#if arrived}}Arrived.{{else}}Arrives at the start of round <input type="number" min="1" value="{{round}}" data-rz-round="{{id}}" style="width:44px">{{/if}}</div></div>
        {{#unless arrived}}<span class="qin-rz-btns">
          <button type="button" data-action="rzPaint" data-id="{{id}}" class="{{#if painting}}qin-on{{/if}}" title="Paint squares for this zone (click or drag; right-click or Esc stops)"><i class="fa-solid fa-paintbrush"></i></button>
          <button type="button" data-action="rzErase" data-id="{{id}}" class="{{#if erasing}}qin-on{{/if}}" title="Erase squares"><i class="fa-solid fa-eraser"></i></button>
          <button type="button" data-action="rzShow" data-id="{{id}}" class="{{#if shown}}qin-on{{/if}}" title="{{#if shown}}Hide these squares from the players again{{else}}Show these squares to the players (the units waiting there stay hidden){{/if}}"><i class="fa-solid fa-eye{{#unless shown}}-slash{{/unless}}"></i></button>
          <button type="button" data-action="rzRemove" data-id="{{id}}" title="Remove the zone (waiting units become visible)"><i class="fa-solid fa-xmark"></i></button></span>{{/unless}}
      </div>
      {{/each}}
      <div class="qin-btns qin-rz-new"><label>Arrives in <input type="number" name="rzRounds" value="2" min="1" style="width:44px"> round(s)</label>
        <button type="button" data-action="rzNew"><i class="fa-solid fa-plus"></i> New zone</button></div>
      <p class="qin-muted">Paint a zone, then drag units onto it: they stay hidden from the players and out of the battle until that round starts.</p>
    </div>{{/if}}
    <div class="qin-btns"><button type="button" data-action="gmPanel" title="Hide/reveal and level up or down the selected units"><i class="fa-solid fa-sliders"></i> GM controls</button></div>
    {{/if}}
  </div>
{{/unless}}
{{#if mapCard}}
  <div class="qin-card qin-map-card"><h4>Battle map</h4>
    {{#if mapCard.ready}}
      <div class="qin-btns">
        <button type="button" data-action="redrawMap" title="Draw this scene's map again with the map generator"><i class="fa-solid fa-rotate"></i> Redraw map</button>
        <button type="button" data-action="paintMap" title="Paint terrain and overlays on this scene's map"><i class="fa-solid fa-paintbrush"></i> Paint map…</button>
      </div>
    {{else}}<p class="qin-muted">{{mapCard.why}}</p>{{/if}}
  </div>
{{/if}}
</div>
