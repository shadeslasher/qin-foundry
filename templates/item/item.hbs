<div class="qin-wrap qin-item">
  <header class="qin-header">
    <img class="qin-portrait small" src="{{item.img}}" data-action="editImage" data-edit="img">
    <div class="qin-head-main">
      <input class="qin-name" name="name" type="text" value="{{item.name}}">
      <span class="qin-muted">{{type}}</span>
    </div>
  </header>
  <div class="qin-grid3">
  {{#if (eq type "weapon")}}
    <label>Skill <select name="system.skill">{{selectOptions martialChoices selected=system.skill}}</select></label>
    <label>Damage <input type="number" name="system.damage" value="{{system.damage}}"></label>
    <label>Resilience <input type="number" name="system.resilience" value="{{system.resilience}}"></label>
    <label>Attack roll modifier <input type="number" name="system.attackModifier" value="{{system.attackModifier}}" title="Added to every attack roll with this weapon (negative to lower it)"></label>
    <label>Range: close <input type="number" name="system.range.c" value="{{system.range.c}}"></label>
    <label>medium <input type="number" name="system.range.m" value="{{system.range.m}}"></label>
    <label>long <input type="number" name="system.range.l" value="{{system.range.l}}"></label>
    <label>extreme <input type="number" name="system.range.e" value="{{system.range.e}}"></label>
    <label>Price <input type="number" name="system.price" value="{{system.price}}"></label>
    <label class="qin-inline"><input type="checkbox" name="system.equipped" {{checked system.equipped}}> Equipped</label>
    <label class="qin-span3">Animation (optional JB2A path, e.g. jb2a.spear.melee.01.white) <input type="text" name="system.animation" value="{{system.animation}}" placeholder="automatic from the weapon's skill"></label>
  {{else if (eq type "armor")}}
    <label>Protection <input type="number" name="system.protection" value="{{system.protection}}"></label>
    <label>Resilience <input type="number" name="system.resilience" value="{{system.resilience}}"></label>
    <label>Active Defense bonus <input type="number" name="system.defenseBonus" value="{{system.defenseBonus}}"></label>
    <label>Passive Defense modifier <input type="number" name="system.pdModifier" value="{{system.pdModifier}}" title="Added to Passive Defense while equipped (negative to lower it)"></label>
    <label>Price <input type="number" name="system.price" value="{{system.price}}"></label>
    <label class="qin-inline"><input type="checkbox" name="system.equipped" {{checked system.equipped}}> Equipped</label>
  {{else if (eq type "tao")}}
    <label>Level known <input type="number" name="system.level" value="{{system.level}}" min="0" max="6"></label>
    <label>Key <input type="text" name="system.key" value="{{system.key}}" placeholder="e.g. strengthenedBody"></label>
  {{else if (eq type "technique")}}
    <label>Skill <select name="system.skill">{{selectOptions martialChoices selected=system.skill}}</select></label>
    <label>Skill level needed <select name="system.skillLevel">{{selectOptions skillLevels selected=system.skillLevel}}</select></label>
    <label>ST increase <input type="number" name="system.stIncrease" value="{{system.stIncrease}}"></label>
    <label>Used on <select name="system.roll">{{selectOptions (qinObj attack="Attack" defense="Active Defense" other="Other") selected=system.roll}}</select></label>
    <label>Range <select name="system.kind">{{selectOptions (qinObj close="Close combat" distance="Distance") selected=system.kind}}</select></label>
  {{else if (eq type "magic")}}
    <label>Way <select name="system.way">{{selectOptions magicWays selected=system.way}}</select></label>
    <label>Skill level <select name="system.skillLevel">{{selectOptions skillLevels selected=system.skillLevel}}</select></label>
    <label>Chi cost <input type="number" name="system.chiCost" value="{{system.chiCost}}"></label>
    <label>Preparation ST (0 = no Test) <input type="number" name="system.prepST" value="{{system.prepST}}"></label>
    <label>Preparation time <input type="text" name="system.prepTime" value="{{system.prepTime}}"></label>
    <label>Duration <input type="text" name="system.duration" value="{{system.duration}}"></label>
    <label>Area <input type="text" name="system.area" value="{{system.area}}"></label>
    <label>Improvements <input type="text" name="system.improvements" value="{{system.improvements}}"></label>
  {{else if (eq type "skill")}}
    <label>Domain <select name="system.domain">{{selectOptions domains selected=system.domain}}</select></label>
    <label>Level <select name="system.value">{{selectOptions skillLevels selected=system.value}}</select></label>
    <label class="qin-inline"><input type="checkbox" name="system.complex" {{checked system.complex}}> Needs Apprentice (*)</label>
    <label class="qin-inline"><input type="checkbox" name="system.martial" {{checked system.martial}}> Fighting skill</label>
  {{else if (eq type "gear")}}
    <label>Quantity <input type="number" name="system.quantity" value="{{system.quantity}}"></label>
    <label>Price <input type="number" name="system.price" value="{{system.price}}"></label>
  {{else if (eq type "officerAbility")}}
    <label>Kind <select name="system.kind">{{selectOptions officerKinds selected=system.kind}}</select></label>
    <label>Morale cost <input type="number" name="system.moraleCost" value="{{system.moraleCost}}"></label>
  {{else if (eq type "formation")}}
    <label>Movement modifier <input type="number" name="system.moveMod" value="{{system.moveMod}}"></label>
    <label class="qin-inline"><input type="checkbox" name="system.immobile" {{checked system.immobile}}> Cannot move</label>
    <label class="qin-inline"><input type="checkbox" name="system.noRear" {{checked system.noRear}}> Can't be attacked in the rear</label>
    <label>Melee &amp; ranged defense <input type="number" name="system.defAll" value="{{system.defAll}}" title="Added to this unit's roll whenever it defends"></label>
    <label>Melee defense <input type="number" name="system.defMelee" value="{{system.defMelee}}"></label>
    <label>Ranged defense <input type="number" name="system.defRanged" value="{{system.defRanged}}"></label>
    <label>Attack <input type="number" name="system.atkMod" value="{{system.atkMod}}" title="Added to this unit's roll only when it attacks"></label>
    <label>Rear attacks against it <input type="number" name="system.rearAtk" value="{{system.rearAtk}}" title="Extra attack for enemies hitting it from the rear (on top of the usual +2)"></label>
    <label class="qin-inline"><input type="checkbox" name="system.noChargeBonus" {{checked system.noChargeBonus}}> Enemies charging it get no charge bonus</label>
    <label class="qin-inline"><input type="checkbox" name="system.winReposition" {{checked system.winReposition}}> After winning an attack, may move to an empty tile next to the enemy</label>
    <label>Defense from the front <input type="number" name="system.defFront" value="{{system.defFront}}" title="Melee and ranged attacks from the front"></label>
    <label>Own melee roll vs the front <input type="number" name="system.frontMelee" value="{{system.frontMelee}}" title="Attacking or defending in melee when the enemy is in front"></label>
    <label>Own cavalry charge roll <input type="number" name="system.chargeBonus" value="{{system.chargeBonus}}"></label>
    <label>Damage modifier <input type="number" name="system.dmgMod" value="{{system.dmgMod}}"></label>
    <label>Fewer casualties taken <input type="number" name="system.casReduce" value="{{system.casReduce}}"></label>
    <label class="qin-inline"><input type="checkbox" name="system.noAttackerBonus" {{checked system.noAttackerBonus}}> Loses the +2 attacker bonus</label>
  {{else if (eq type "signature")}}
    <label>Slot <select name="system.slot">{{selectOptions signatureSlots selected=system.slot}}</select></label>
    {{#if (eq system.slot "active")}}<label>Chi cost <input type="number" name="system.chiCost" value="{{system.chiCost}}"></label>{{/if}}
    {{#if (eq system.slot "battleActive")}}<label>Morale cost <input type="number" name="system.moraleCost" value="{{system.moraleCost}}"></label>{{/if}}
  {{/if}}
  </div>

  {{#if (eq type "tao")}}
  <h3>Effects by level</h3>
  <label>Level 1 <textarea name="system.effects.l1" rows="2">{{system.effects.l1}}</textarea></label>
  <label>Level 2 <textarea name="system.effects.l2" rows="2">{{system.effects.l2}}</textarea></label>
  <label>Level 3 <textarea name="system.effects.l3" rows="2">{{system.effects.l3}}</textarea></label>
  <label>Level 4 <textarea name="system.effects.l4" rows="2">{{system.effects.l4}}</textarea></label>
  {{/if}}

  {{#if showEffects}}
  <h3>Automated battlefield effects</h3>
  <p class="qin-muted">Used by the battle system when this officer leads a unit. Anything else is applied by hand.</p>
  <div class="qin-grid2">
    {{#each officerEffects}}
    {{#if (eq type "boolean")}}
      <label class="qin-inline"><input type="checkbox" name="system.effects.{{key}}" {{checked value}}> {{label}}</label>
    {{else}}
      <label>{{label}} <input type="number" name="system.effects.{{key}}" value="{{value}}"></label>
    {{/if}}
    {{/each}}
  </div>
  {{/if}}

  <h3>Description</h3>
  {{#if readOnlyDesc}}<div class="qin-desc-read">{{{system.description}}}</div>{{else}}<textarea name="system.description" rows="8">{{system.description}}</textarea>{{/if}}
  {{#if draft}}
  <footer class="qin-draft-footer">
    <button type="button" data-action="draftCancel"><i class="fa-solid fa-xmark"></i> Cancel</button>
    <button type="button" class="qin-primary" data-action="draftDone"><i class="fa-solid fa-check"></i> Done</button>
  </footer>
  {{/if}}
</div>
