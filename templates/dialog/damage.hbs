<div class="qin-dialog">
  <p>Apply damage to <b>{{name}}</b>.</p>
  <div class="form-group"><label>Damage</label><input type="number" name="damage" value="{{damage}}"></div>
  <div class="form-group"><label>Armor protection</label><input type="number" name="protection" value="{{protection}}"></div>
  <div class="form-group"><label>Armor reduced by (Direct Hit / Masterstroke)</label><input type="number" name="pierce" value="{{pierce}}"></div>
  <div class="form-group"><label>Other reduction (Hard Hide, Strong Defense…)</label><input type="number" name="reduction" value="0"></div>
</div>
