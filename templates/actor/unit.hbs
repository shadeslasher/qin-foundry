<div class="qin-wrap qin-unit-dark">
  <header class="qin-ud-hd">
    <img class="qin-ud-portrait" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}">
    <div class="qin-ud-id">
      {{#if faction}}<div class="qin-ud-ti">{{#if faction.img}}<img src="{{faction.img}}" alt="">{{/if}}{{faction.name}}</div>{{/if}}
      <input class="qin-ud-name" name="name" type="text" value="{{actor.name}}" placeholder="Unit name">
      <div class="qin-ud-row">
        <label>Unit type <input type="text" name="system.unitType" value="{{system.unitType}}" placeholder="e.g. Spear and Shield"></label>
        <label>Side <select name="system.side">{{selectOptions sides selected=system.side}}</select></label>
        <label>Faction <button type="button" class="qin-faction-btn" {{#if editable}}data-action="pickFaction"{{else}}disabled{{/if}} title="{{#if editable}}Choose a faction{{/if}}">
          {{#if faction}}{{#if faction.img}}<img src="{{faction.img}}" alt="">{{else}}<i class="fa-solid fa-flag"></i>{{/if}} <span>{{faction.name}}</span>{{else}}<i class="fa-solid fa-flag"></i> <span class="qin-muted">No faction</span>{{/if}}
        </button></label>
        <label>Status <select name="system.status">{{selectOptions (qinObj active="Active" defeated="Defeated" surrendered="Surrendered" escaped="Escaped") selected=system.status}}</select></label>
      </div>
    </div>
    <span class="qin-tt-tier t{{tierN}}">T{{system.tier}}</span>
  </header>

  <section class="qin-ud-bars">
    <span>Health</span><div class="qin-ud-bar"><i style="width:{{menPct}}%;background:{{healthColor}}"></i></div><b><input type="number" name="system.men.value" value="{{system.men.value}}" min="0"> / {{system.men.max}}</b>
    <span>Morale</span><div class="qin-ud-bar"><i style="width:{{system.morale}}%;background:{{moraleColor}}"></i></div><b><input type="number" name="system.morale" value="{{system.morale}}" min="0" max="100"><small>{{system.moraleState}}</small></b>
    <span class="qin-ud-lv">Level <input type="number" name="system.level" value="{{system.level}}" min="1"></span><div class="qin-ud-bar"><i style="width:{{xpPct}}%;background:#c9a24a"></i></div><b><input type="number" name="system.xp.value" value="{{system.xp.value}}" min="0"> / {{system.xp.max}} XP</b>
  </section>

  <nav class="qin-tabs qin-ud-tabs"><a data-tab="stats">Unit</a><a data-tab="formations">Formations</a><a data-tab="officer">Officer</a><a data-tab="equipment">Equipment{{#if equipment.length}} <span class="qin-trait-badge gold">{{equipment.length}}</span>{{/if}}</a><a data-tab="notes">Traits{{#if traitChoices}} <span class="qin-trait-badge">{{traitChoices}}</span>{{/if}}</a></nav>
  <div class="qin-body">
    <section class="qin-tab" data-tab="stats">
      <div class="qin-ud-sech">Battle</div>
      <div class="qin-ud-tiles">
        <label class="qin-ud-tile"><i>{{{icons.dmg}}}</i><input type="number" name="system.damage" value="{{system.damage}}" min="0"><small>Damage</small></label>
        <label class="qin-ud-tile"><i>{{{icons.pen}}}</i><input type="number" name="system.armorPen" value="{{system.armorPen}}" min="0"><small>Pierce</small></label>
        <label class="qin-ud-tile"><i>{{{icons.armor}}}</i><input type="number" name="system.armor" value="{{system.armor}}" min="0"><small>Armor</small></label>
        <label class="qin-ud-tile"><i>{{{icons.move}}}</i><input type="number" name="system.move" value="{{system.move}}" min="0"><small>Move</small></label>
        <label class="qin-ud-tile" data-tooltip="1 = melee"><i><i class="fa-solid fa-bullseye qin-ud-fa"></i></i><input type="number" name="system.range" value="{{system.range}}" min="1"><small>Range</small></label>
        <label class="qin-ud-tile"><i><i class="fa-solid fa-coins qin-ud-fa"></i></i><input type="number" name="system.unitValue" value="{{system.unitValue}}" min="0"><small>Value</small></label>
      </div>
      <div class="qin-ud-sech">Profile</div>
      <div class="qin-grid3 qin-ud-fields">
        <label>Tier <input type="number" name="system.tier" value="{{system.tier}}" min="1" max="6"></label>
        <label>Category <select name="system.category">{{selectOptions categories selected=system.category}}</select></label>
        <label>Officer weapon skill <select name="system.weaponSkill">{{selectOptions weaponSkills selected=system.weaponSkill}}</select></label>
        <label data-tooltip="For units with two weapons: the officer uses whichever of the two skills is higher">Second weapon skill <select name="system.weaponSkill2">{{selectOptions weaponSkills2 selected=system.weaponSkill2}}</select></label>
        <label>Max health <input type="number" name="system.men.max" value="{{system.men.max}}" min="1"></label>
        <label>Armor breakdown <input type="text" name="system.armorNote" value="{{system.armorNote}}" placeholder="e.g. 2 + 2 (Shield)"></label>
        {{#if system.isRanged}}<label>Minimum range <input type="number" name="system.rangeMin" value="{{system.rangeMin}}" min="1"></label>{{/if}}
      </div>
      <div class="qin-ud-sech">Cost</div>
      <div class="qin-ud-cost">
        <label>Recruitment cost <span class="qin-cost-row"><input type="number" name="system.cost" value="{{system.cost}}" min="0"> coins</span></label>
        <label data-tooltip="A quarter of the recruitment cost, every month">Upkeep <span class="qin-cost-row"><b>{{system.upkeep}}</b> coins per month</span></label>
      </div>
      <label class="qin-inline qin-ud-chk"><input type="checkbox" name="system.hidden" {{checked system.hidden}}> Hidden (attacks from hiding are ambushes)</label>
      <p class="qin-muted qin-ud-note">XP: casualties dealt × (enemy tier ÷ this unit's tier), rounded down; a kill adds 25 × the same ratio. Every 100 XP the unit gains a level (tier stays the same; levels are for the promotion tree).</p>
    </section>

    <section class="qin-tab" data-tab="formations">
      <div class="qin-ud-sech">Formations</div>
      <label>Current formation <select name="system.formation">{{selectOptions formationChoices selected=system.formation}}</select></label>
      <ul class="qin-formations">
        {{#each formations}}
        <li data-item-id="{{id}}" class="{{#if active}}active{{/if}}">
          <div class="qin-form-head"><b>{{name}}</b>{{#if active}} <span class="qin-tag">in use</span>{{/if}}
            {{#if @root.isGM}}<span class="qin-controls"><a data-action="itemEdit" title="Edit"><i class="fa-solid fa-pen"></i></a><a data-action="itemDelete" title="Remove"><i class="fa-solid fa-trash"></i></a></span>{{/if}}
          </div>
          {{#if summary}}<div class="qin-form-fx">{{summary}}</div>{{/if}}
          <div class="qin-form-desc">{{{description}}}</div>
        </li>
        {{else}}<li class="qin-muted">No formations yet.{{#if @root.isGM}} Add some below.{{/if}}</li>
        {{/each}}
      </ul>
      {{#if isGM}}
      <div class="qin-library qin-form-add">
        <div class="qin-picker" data-library="formations">
          <button type="button" class="qin-picker-toggle"><span class="qin-picker-label">Choose a formation…</span> <i class="fa-solid fa-caret-down"></i></button>
          <ul class="qin-picker-list">
            {{#each formationLibrary}}<li data-uuid="{{uuid}}" class="{{#if owned}}owned{{/if}}">{{name}}{{#if owned}} <span class="qin-muted">(has it)</span>{{/if}}</li>{{/each}}
          </ul>
          <div class="qin-picker-info"></div>
        </div>
        <button type="button" data-action="addFormation"><i class="fa-solid fa-plus"></i> Add</button>
        <button type="button" data-action="itemCreate" data-type="formation"><i class="fa-solid fa-feather"></i> Homebrew</button>
      </div>
      {{else}}<p class="qin-muted">Only the GM can add or change this unit's formations.</p>{{/if}}
    </section>

    <section class="qin-tab" data-tab="officer">
      <div class="qin-ud-sech">Officer</div>
      <div class="qin-officer-drop">
        {{#if officer}}
          <img src="{{officer.img}}" class="qin-officer-img">
          <div>
            {{#if officer.system.details.title}}<div class="qin-ud-otitle">{{officer.system.details.title}}</div>{{/if}}
            <h3><a data-action="openOfficer">{{officer.name}}</a></h3>
            <p>Fire {{officerStats.fire}} · Command {{officerStats.command}} · {{officerStats.skillLabel}} {{officerStats.skill}}</p>
            <p class="qin-muted">Command {{officerStats.command}} is added to the unit's rolls; Fire + Command restores morale on turns it doesn't fight.</p>
            {{#if officerProblem}}<p class="qin-officer-warn"><i class="fa-solid fa-triangle-exclamation"></i> Can't lead this unit ({{officerProblem}}): it fights without an officer.</p>{{/if}}
            {{#if editable}}<a data-action="clearOfficer"><i class="fa-solid fa-xmark"></i> Remove officer</a>{{/if}}
          </div>
        {{else}}
          <p>Choose an officer below, or drag a Qin character here from the Actors list. An officer needs the unit's weapon skill at the unit's tier or higher (and Horsemanship for cavalry). Without one, the unit counts Command as 0 and has no initiative.</p>
        {{/if}}
      </div>
      {{#if editable}}
      <div class="qin-officer-pick"><label>Officer</label>
        <select data-officer-pick><option value="">No officer</option>{{#each officerChoices}}<option value="{{uuid}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{name}}{{#if disabled}} ({{reason}}){{/if}}</option>{{/each}}</select>
      </div>
      {{else}}<p class="qin-muted">Only this unit's owner or the GM can change its officer.</p>{{/if}}
    </section>

    <section class="qin-tab" data-tab="equipment">
      <div class="qin-ud-sech">Equipment{{#if editable}}<button type="button" class="qin-eq-add" data-action="equipPick" title="Equip this unit from the whole range of equipment"><i class="fa-solid fa-plus"></i></button>{{/if}}</div>
      <div class="qin-traits qin-eq-list">
        {{#each equipment}}
        <article class="qin-trait equip">
          <header class="qin-trait-head"><span class="qin-trait-name"><i class="fa-solid fa-shield-halved"></i> {{name}}</span>
            {{#if @root.editable}}<span class="qin-controls"><a data-action="unequip" data-name="{{name}}" title="Remove"><i class="fa-solid fa-trash"></i></a></span>{{/if}}</header>
          {{#if desc}}<p class="qin-trait-desc">{{desc}}</p>{{/if}}
        </article>
        {{else}}<p class="qin-muted">Nothing equipped.{{#if editable}} Press + to equip this unit.{{/if}}</p>
        {{/each}}
      </div>
    </section>

    <section class="qin-tab" data-tab="notes">
      <div class="qin-ud-sech">Traits</div>
      <div class="qin-traits" data-traits>
        {{#each traitCards}}
        {{#if isChoice}}
        <article class="qin-trait choice{{#if replacedBy}} replaced{{/if}}{{#if locked}} locked{{/if}}{{#if pending}} pending{{/if}}{{#if editing}} editing{{/if}}" data-trait="{{index}}">
          <header class="qin-trait-head">
            <span class="qin-trait-name">{{#if chosen}}{{chosen.name}}{{else}}{{title}}{{/if}}</span>
            {{#if locked}}<span class="qin-trait-lock"><i class="fa-solid fa-lock"></i> Choose at level {{level}}</span>{{/if}}
            {{#if pending}}<span class="qin-trait-badge">Choose one</span>{{/if}}
            {{#if replacedBy}}<span class="qin-trait-lock"><i class="fa-solid fa-arrow-up"></i> Replaced by {{replacedBy}}</span>{{/if}}
            {{#if @root.isGM}}<span class="qin-controls">
              {{#if chosen}}<a data-trait-act="unchoose" title="Undo the choice"><i class="fa-solid fa-rotate-left"></i></a>{{/if}}
              <a data-trait-act="edit" title="{{#if editing}}Done{{else}}Edit{{/if}}"><i class="fa-solid {{#if editing}}fa-check{{else}}fa-pen{{/if}}"></i></a>
              <a data-trait-act="remove" title="Remove"><i class="fa-solid fa-trash"></i></a></span>{{/if}}
          </header>
          {{#if chosen}}
            {{#if chosen.desc}}<p class="qin-trait-desc">{{chosen.desc}}</p>{{/if}}
            <ol class="qin-trait-chain">{{#each choices}}<li class="{{#if picked}}current{{else}}done{{/if}}" title="{{desc}}"><span>Lv {{../level}}</span> {{name}}</li>{{/each}}</ol>
          {{else}}
            <div class="qin-trait-options">
              {{#each choices}}
              <div class="qin-trait-option">
                <b>{{name}}</b>{{#if desc}}<span>{{desc}}</span>{{/if}}
                {{#if ../pending}}{{#if @root.editable}}<button type="button" data-trait-act="choose" data-opt="{{@index}}">Choose</button>{{/if}}{{/if}}
              </div>
              {{/each}}
            </div>
          {{/if}}
          {{#if editing}}
          <div class="qin-trait-edit">
            <div class="qin-trait-row">
              <label>Title (shown until chosen) <input type="text" data-field="name" value="{{name}}" placeholder="Choose a trait"></label>
              <label class="qin-trait-lv">Choose at level <input type="number" min="1" data-field="level" value="{{level}}"></label>
            </div>
            <div class="qin-trait-ups">
              {{#each options}}
              <div class="qin-trait-up" data-opt="{{@index}}">
                <label>Option {{inc @index}} <input type="text" data-field="name" value="{{name}}"></label>
                <a data-trait-act="removeOption" title="Remove this option"><i class="fa-solid fa-xmark"></i></a>
                <label class="qin-trait-updesc">Description <textarea rows="2" data-field="desc">{{desc}}</textarea></label>
              </div>
              {{/each}}
              <button type="button" data-trait-act="addOption"><i class="fa-solid fa-plus"></i> Add an option</button>
            </div>
          </div>
          {{/if}}
        </article>
        {{else}}
        <article class="qin-trait{{#if replacedBy}} replaced{{/if}}{{#if locked}} locked{{/if}}{{#if editing}} editing{{/if}}" data-trait="{{index}}">
          <header class="qin-trait-head">
            <span class="qin-trait-name">{{current.name}}</span>
            {{#if locked}}<span class="qin-trait-lock"><i class="fa-solid fa-lock"></i> Unlocks at level {{level}}</span>{{/if}}
            {{#if replacedBy}}<span class="qin-trait-lock"><i class="fa-solid fa-arrow-up"></i> Replaced by {{replacedBy}}</span>{{/if}}
            {{#if @root.isGM}}<span class="qin-controls">
              <a data-trait-act="edit" title="{{#if editing}}Done{{else}}Edit{{/if}}"><i class="fa-solid {{#if editing}}fa-check{{else}}fa-pen{{/if}}"></i></a>
              <a data-trait-act="remove" title="Remove"><i class="fa-solid fa-trash"></i></a></span>{{/if}}
          </header>
          {{#if current.desc}}<p class="qin-trait-desc">{{current.desc}}</p>{{/if}}
          {{#if chain}}<ol class="qin-trait-chain">
            {{#each steps}}<li class="{{state}}" title="{{desc}}">{{#if (eq state "locked")}}<i class="fa-solid fa-lock"></i> {{/if}}<span>Lv {{level}}</span> {{name}}</li>{{/each}}
          </ol>{{/if}}
          {{#if editing}}
          <div class="qin-trait-edit">
            <div class="qin-trait-row">
              <label>Name <input type="text" data-field="name" value="{{name}}"></label>
              <label class="qin-trait-lv">Unlocks at level <input type="number" min="1" data-field="level" value="{{level}}"></label>
            </div>
            <label>Description <textarea rows="2" data-field="desc">{{desc}}</textarea></label>
            <div class="qin-trait-ups">
              {{#each upgrades}}
              <div class="qin-trait-up" data-up="{{@index}}">
                <label class="qin-trait-lv">At level <input type="number" min="1" data-field="level" value="{{level}}"></label>
                <label>Becomes <input type="text" data-field="name" value="{{name}}"></label>
                <a data-trait-act="removeUpgrade" title="Remove this upgrade"><i class="fa-solid fa-xmark"></i></a>
                <label class="qin-trait-updesc">Description <textarea rows="2" data-field="desc">{{desc}}</textarea></label>
              </div>
              {{/each}}
              <button type="button" data-trait-act="addUpgrade"><i class="fa-solid fa-angles-up"></i> Add a level upgrade</button>
            </div>
          </div>
          {{/if}}
        </article>
        {{/if}}
        {{else}}<p class="qin-muted">No traits.</p>
        {{/each}}
      </div>
      {{#if isGM}}
      <div class="qin-trait-add">
        <input type="text" data-trait-new placeholder="Trait name (pick one or type a new one)">
        <button type="button" data-trait-act="add"><i class="fa-solid fa-plus"></i> Add trait</button>
        <button type="button" data-trait-act="addChoice" title="At a level, the unit picks one of several traits"><i class="fa-solid fa-code-branch"></i> Add choice</button>
      </div>
      {{/if}}
    </section>
  </div>
</div>
