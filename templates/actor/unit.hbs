<div class="qin-wrap">
  <header class="qin-header">
    <img class="qin-portrait" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}">
    <div class="qin-head-main">
      <input class="qin-name" name="name" type="text" value="{{actor.name}}" placeholder="Unit name">
      <div class="qin-details">
        <label>Unit type <input type="text" name="system.unitType" value="{{system.unitType}}" placeholder="e.g. Spear and Shield"></label>
        <label>Side <select name="system.side">{{selectOptions sides selected=system.side}}</select></label>
        <label>Faction <button type="button" class="qin-faction-btn" {{#if editable}}data-action="pickFaction"{{else}}disabled{{/if}} title="{{#if editable}}Choose a faction{{/if}}">
          {{#if faction}}{{#if faction.img}}<img src="{{faction.img}}" alt="">{{else}}<i class="fa-solid fa-flag"></i>{{/if}} <span>{{faction.name}}</span>{{else}}<i class="fa-solid fa-flag"></i> <span class="qin-muted">No faction</span>{{/if}}
        </button></label>
        <label>Status <select name="system.status">{{selectOptions (qinObj active="Active" defeated="Defeated" surrendered="Surrendered") selected=system.status}}</select></label>
      </div>
    </div>
  </header>

  <section class="qin-unit-bars">
    <div><b>Health</b> <input type="number" name="system.men.value" value="{{system.men.value}}" min="0"> / {{system.men.max}}
      <div class="qin-bar"><i style="width:{{menPct}}%"></i></div></div>
    <div><b>Morale</b> <input type="number" name="system.morale" value="{{system.morale}}" min="0" max="100"> <span class="qin-tag qin-{{system.moraleState}}">{{system.moraleState}}</span>
      <div class="qin-bar morale"><i style="width:{{system.morale}}%"></i></div></div>
    <div><b>Level</b> <input type="number" name="system.level" value="{{system.level}}" min="1" class="qin-short">
      <b>XP</b> <input type="number" name="system.xp.value" value="{{system.xp.value}}" min="0"> / {{system.xp.max}}
      <div class="qin-bar xp"><i style="width:{{xpPct}}%"></i></div></div>
  </section>

  <nav class="qin-tabs"><a data-tab="stats">Unit</a><a data-tab="formations">Formations</a><a data-tab="officer">Officer</a><a data-tab="notes">Traits</a></nav>
  <div class="qin-body">
    <section class="qin-tab" data-tab="stats">
      <div class="qin-grid3">
        <label>Tier <input type="number" name="system.tier" value="{{system.tier}}" min="1" max="6"></label>
        <label>Category <select name="system.category">{{selectOptions categories selected=system.category}}</select></label>
        <label>Officer weapon skill <select name="system.weaponSkill">{{selectOptions weaponSkills selected=system.weaponSkill}}</select></label>
        <label>Max health <input type="number" name="system.men.max" value="{{system.men.max}}" min="1"></label>
        <label>Armor <input type="number" name="system.armor" value="{{system.armor}}" min="0"></label>
        <label>Armor breakdown <input type="text" name="system.armorNote" value="{{system.armorNote}}" placeholder="e.g. 2 + 2 (Shield)"></label>
        <label>Damage <input type="number" name="system.damage" value="{{system.damage}}" min="0"></label>
        <label>Armor penetration <input type="number" name="system.armorPen" value="{{system.armorPen}}" min="0"></label>
        <label>Movement <input type="number" name="system.move" value="{{system.move}}" min="0"></label>
        <label>Range (1 = melee) <input type="number" name="system.range" value="{{system.range}}" min="1"></label>
        {{#if system.isRanged}}<label>Minimum range <input type="number" name="system.rangeMin" value="{{system.rangeMin}}" min="1"></label>{{/if}}
        <label>Unit Value <input type="number" name="system.unitValue" value="{{system.unitValue}}" min="0"></label>
      </div>
      <label class="qin-inline"><input type="checkbox" name="system.hidden" {{checked system.hidden}}> Hidden (attacks from hiding are ambushes)</label>
      <p class="qin-muted">XP: casualties dealt × (enemy tier ÷ this unit's tier), rounded down; a kill adds 25 × the same ratio. Every 100 XP the unit gains a level (tier stays the same; levels are for the promotion tree). After a battle the unit loses XP equal to the casualties it suffered.</p>
    </section>

    <section class="qin-tab" data-tab="formations">
      <label>Current formation <select name="system.formation">{{selectOptions formationChoices selected=system.formation}}</select></label>
      <ul class="qin-formations">
        {{#each formations}}
        <li data-item-id="{{id}}" class="{{#if active}}active{{/if}}">
          <div class="qin-form-head"><b>{{name}}</b>{{#if active}} <span class="qin-tag">in use</span>{{/if}}
            {{#if @root.isGM}}<span class="qin-controls"><a data-action="itemEdit" title="Edit"><i class="fa-solid fa-pen"></i></a><a data-action="itemDelete" title="Remove"><i class="fa-solid fa-trash"></i></a></span>{{/if}}
          </div>
          {{#if summary}}<div class="qin-form-fx">{{summary}}</div>{{/if}}
          <div class="qin-form-desc">{{{description}}}</div>
        </li>
        {{else}}<li class="qin-muted">No formations yet.{{#if @root.isGM}} Add some below.{{/if}}</li>
        {{/each}}
      </ul>
      {{#if isGM}}
      <div class="qin-library qin-form-add">
        <div class="qin-picker" data-library="formations">
          <button type="button" class="qin-picker-toggle"><span class="qin-picker-label">Choose a formation…</span> <i class="fa-solid fa-caret-down"></i></button>
          <ul class="qin-picker-list">
            {{#each formationLibrary}}<li data-uuid="{{uuid}}" class="{{#if owned}}owned{{/if}}">{{name}}{{#if owned}} <span class="qin-muted">(has it)</span>{{/if}}</li>{{/each}}
          </ul>
          <div class="qin-picker-info"></div>
        </div>
        <button type="button" data-action="addFormation"><i class="fa-solid fa-plus"></i> Add</button>
        <button type="button" data-action="itemCreate" data-type="formation"><i class="fa-solid fa-feather"></i> Homebrew</button>
      </div>
      {{else}}<p class="qin-muted">Only the GM can add or change this unit's formations.</p>{{/if}}
    </section>

    <section class="qin-tab" data-tab="officer">
      <div class="qin-officer-drop">
        {{#if officer}}
          <img src="{{officer.img}}" class="qin-officer-img">
          <div>
            <h3><a data-action="openOfficer">{{officer.name}}</a></h3>
            <p>Fire {{officerStats.fire}} · Command {{officerStats.command}} · {{officerStats.skillLabel}} {{officerStats.skill}}</p>
            {{#if editable}}<a data-action="clearOfficer"><i class="fa-solid fa-xmark"></i> Remove officer</a>{{/if}}
          </div>
        {{else}}
          <p>Drag a Qin character here to make them this unit's officer. Without one, the unit counts Command, Fire and Skill as 0 and has no initiative.</p>
        {{/if}}
      </div>
    </section>

    <section class="qin-tab" data-tab="notes"><textarea name="system.traits" rows="14">{{system.traits}}</textarea></section>
  </div>
</div>
